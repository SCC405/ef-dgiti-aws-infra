# Copiar como terraform.tfvars y ajustar si hace falta.
# terraform.tfvars está en .gitignore: nunca se sube al repositorio.
# Las credenciales de AWS NO van aquí: Terraform las toma de ~/.aws/credentials.

aws_region = "us-east-1"
project    = "ef-dgiti"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]
app_subnet_cidrs    = ["10.20.11.0/24", "10.20.12.0/24"]
db_subnet_cidrs     = ["10.20.21.0/24", "10.20.22.0/24"]

instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4
cpu_target           = 50

repo_url    = "https://github.com/SCC405/ef-dgiti-aws-infra.git"
repo_branch = "main"

db_instance_class = "db.t3.micro"
db_engine_version = "17"
db_name           = "appdb"
db_username       = "appadmin"
